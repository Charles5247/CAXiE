# ─────────────────────────────────────────────────────────────────────────────
# CAXiE Technologies — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git. All secrets must be set in the host
# platform's dashboard (Render, Netlify, or Vercel) as environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Render Deployment Mode ────────────────────────────────────────────────────
# Controls which routes this Render service exposes (middleware.js uses this).
#
#   APP_MODE=public   → public service (caxietechnologies.com)
#                       /admin paths return 404 — not discoverable
#
#   APP_MODE=admin    → admin service (admin.caxietechnologies.com)
#                       only /admin and /api/admin paths are served
#
#   (unset)           → local development: all routes accessible
#
# Set this in the Render dashboard per-service, NOT in .env.local.
APP_MODE=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required for blog (ISR), admin blog CRUD, and any future Supabase tables.
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Formspree ─────────────────────────────────────────────────────────────────
# Used by the /contact page form submission.
# Get from: https://formspree.io/forms → your form → Endpoint
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# ── Admin CMS ─────────────────────────────────────────────────────────────────
# Credentials for the admin dashboard at /admin
# Use a strong, unique password. Store only in the hosting platform's env vars.
ADMIN_EMAIL=admin@caxietechnologies.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Optional: Analytics ───────────────────────────────────────────────────────
# If you add Google Analytics, Plausible, or Posthog later:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=caxietechnologies.com
